# Public Supabase project values. Safe to expose; RLS remains the data boundary.
NEXT_PUBLIC_SUPABASE_URL=
# Preferred modern browser-safe key name.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy projects may use this instead of NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. Never prefix secrets with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Disabled by default. Enabling requires the documented future marketplace migration.
FEATURE_MARKETPLACE=false

# Local fixture mode is explicit and never represents a live integration.
NEXT_PUBLIC_DEMO_MODE=true
